# Base URL of the UMS Express API.
# Used server-side only (BFF proxy, auth route handlers, middleware, Server Components).
API_URL=http://localhost:5000/api/v1

# Public URL of this Next.js app (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Matching BACKEND .env values:
#   CLIENT_URL=http://localhost:3000
#   STRIPE_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
#   STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel?session_id={CHECKOUT_SESSION_ID}
# ---------------------------------------------------------------------------
